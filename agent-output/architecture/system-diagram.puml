@startuml
!theme plain
skinparam componentStyle uml2

package "VS Code Workspace" {
  [agent-output/]
  [memories/repo/]
  [.github/skills/]
}

package "Memory Layer (Obsidian)" {
  [Workflow Nodes (WF-*)]
  [Long-term Memory]
}

package "Execution Layer (Planka)" {
  [Epics Board]
  [Tasks/Checklists]
}

package "Agent Roles" {
  component [Roadmap Agent] <<Owner>>
  component [Architect Agent] <<Design Authority>>
  component [Analyst Agent] <<Research>>
  component [Planner/Critic] <<Execution Link>>
  component [Implementer/QA] <<Execution>>
}

[Roadmap Agent] --> [Epics Board] : Syncs Epics
[Architect Agent] -- [agent-output/architecture/] : Maintains
[Architect Agent] ..> [Workflow Nodes (WF-*)] : Records Decisions
[Planner/Critic] --> [Tasks/Checklists] : Defines Actions
[Implementer/QA] --> [agent-output/test-runs/] : Logs Results
[Agent Roles] ..> [Long-term Memory] : Consults
@enduml
