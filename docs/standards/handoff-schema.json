{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Multi-Agent Handoff Object (v0.1.0)",
  "description": "Standardized contract for task-oriented handoffs between architectural roles (Planner, Architect, Implementer, etc.).",
  "type": "object",
  "required": [
    "id",
    "origin_id",
    "correlation_id",
    "author_role",
    "status",
    "session_id",
    "artifacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifiers (e.g., WF-123 or a UUID)."
    },
    "origin_id": {
      "type": "string",
      "description": "The ID of the parent handoff or event (Original triggering handoff)."
    },
    "correlation_id": {
      "type": "string",
      "description": "The shared ID across the entire epic or multi-agent chain."
    },
    "author_role": {
      "type": "string",
      "enum": [
        "Roadmap",
        "Architect",
        "Analyst",
        "Planner",
        "Critic",
        "Implementer",
        "Reviewer",
        "QA",
        "UAT",
        "DevOps"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Completed",
        "Failed",
        "Aborted"
      ]
    },
    "session_id": {
      "type": "string",
      "description": "The VS Code session ID (prevents cross-session context injection)."
    },
    "artifacts": {
      "type": "array",
      "description": "Immutable list of files created or modified during this handoff.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "planka_task_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Workspace-relative path (using '/') without leading slash."
          },
          "hash": {
            "type": "string",
            "description": "SHA-256 hex digest of the file content."
          },
          "planka_task_id": {
            "type": "string",
            "description": "Numerical ID of the corresponding Planka task (for visual parity)."
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "description": "Sanitized signals for monitoring and debugging.",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "normal",
            "debug"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Redaction rules: sk-[a-zA-Z0-9]{20,}, xox[bpg]-[a-zA-Z0-9-]{10,}"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
